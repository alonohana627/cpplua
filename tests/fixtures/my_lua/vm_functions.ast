Chunk
  LocalFunction show
    Function(v)
      If
        If
          Binary ==
            Name v (local 0)
            Nil
          Then
            Return
              String "nil"
      If
        If
          Binary ==
            Name v (local 0)
            True
          Then
            Return
              String "true"
      If
        If
          Binary ==
            Name v (local 0)
            False
          Then
            Return
              String "false"
      Return
        Name v (local 0)
  LocalFunction list
    Function(n, first, ...) [upvalues: show, list]
      If
        If
          Binary ==
            Name n (local 0)
            Integer 0
          Then
            Return
              String ""
      If
        If
          Binary ==
            Name n (local 0)
            Integer 1
          Then
            Return
              Call
                Name show (upvalue 0)
                Name first (local 1)
      Return
        Binary ..
          Call
            Name show (upvalue 0)
            Name first (local 1)
          Binary ..
            String ","
            Call
              Name list (upvalue 1)
              Binary -
                Name n (local 0)
                Integer 1
              Vararg
