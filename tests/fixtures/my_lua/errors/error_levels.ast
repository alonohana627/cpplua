        Function() [upvalues: _ENV]
          CallStatement
            Call
              Name error
              True
              Integer 2
  Local t
    Table
  Local ok, e
    Call
      Name pcall
      Function() [upvalues: _ENV, t]
        CallStatement
          Call
            Name error
            Name t (upvalue 1)
            Integer 1
  CallStatement
    Call
      Name print
      Name ok (local 9)
      Binary ==
        Name e (local 10)
        Name t (local 8)
  CallStatement
    Call
      Name print
      Call
        Name pcall
        Function() [upvalues: _ENV]
          CallStatement
            Call
              Name error
              String "42"
  Local obj
    Table
  FunctionStatement (method)
    Index
      Name obj (local 11)
      String "fail"
    Function(self) [upvalues: _ENV]
      CallStatement
        Call
          Name error
          String "method failed"
  CallStatement
    Call
      Name print
      Call
        Name pcall
        Index
          Name obj (local 11)
          String "fail"
        Name obj (local 11)
  CallStatement
