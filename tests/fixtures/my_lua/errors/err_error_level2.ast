Chunk
  LocalFunction need_string
    Function(s) [upvalues: _ENV]
      If
        If
          Binary ~=
            Call
              Name type
              Name s (local 0)
            String "string"
          Then
            CallStatement
              Call
                Name error
                Binary ..
                  String "need a string, got "
                  Call
                    Name type
                    Name s (local 0)
                Integer 2
      Return
        Name s (local 0)
  CallStatement
    Call
      Name need_string (local 0)
      String "fine"
  Local x
    Call
      Name need_string (local 0)
      Integer 42
  CallStatement
    Call
      Name print
      Name x (local 1)
