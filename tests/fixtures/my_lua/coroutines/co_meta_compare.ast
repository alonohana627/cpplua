  Local answers
    Table
      Field eq
        Function(a, b)
          Return
            Binary or
              Binary and
                Binary ==
                  Name a (local 0)
                  Name b (local 1)
                String "yes"
              Nil
      Field lt
        Function(a, b)
          Return
            Binary or
              Binary and
                Binary <
                  Name a (local 0)
                  Name b (local 1)
                Integer 1
              False
      Field le
