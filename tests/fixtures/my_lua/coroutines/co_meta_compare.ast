                Name one (local 0)
                Name two (local 1)
              Binary >
                Name two (local 1)
                Name one (local 0)
            Then
              CallStatement
                Call
                  Name print
                  String "if ok"
        Local n
          Integer 0
        Local i
          Call
            Name O (upvalue 0)
            Integer 0
        While
          Binary <
            Name i (local 4)
            Call
              Name O (upvalue 0)
              Integer 3
          Body
            Assign
              Targets
                Name n (local 3)
              Values
                Binary +
                  Name n (local 3)
                  Integer 1
            Assign
