prefix=${pcfiledir}/@CPPLUA_PC_TO_PREFIX@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@

Name: cpplua
Description: @PROJECT_DESCRIPTION@ (build with clang, libc++ and -std=c++2c)
URL: @PROJECT_HOMEPAGE_URL@
Version: @CPPLUA_VERSION_STRING@
Cflags: -std=c++2c -stdlib=libc++ -I${includedir}
Libs: -stdlib=libc++ -L${libdir} -lcpplua
